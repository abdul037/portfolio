# Production configuration. All optional — the app builds and runs with none of
# these set (indexing simply stays off and OG/canonical URLs use a placeholder
# origin). Copy to `.env.local` for local overrides, or set in your host's
# environment for a deploy.

# Canonical origin of the deployed site, no trailing slash.
# Sets metadataBase so OpenGraph/Twitter and canonical URLs resolve absolutely,
# and provides the sitemap host.
# NEXT_PUBLIC_SITE_URL=https://abdulmuwahib.com

# Set to "true" to let search engines index the site. Anything else (the
# default) serves noindex + a Disallow: / robots rule. Keep it off until the
# confidentiality review of screenshots and operational numbers is complete.
# Requires NEXT_PUBLIC_SITE_URL to also be set.
# NEXT_PUBLIC_ALLOW_INDEXING=true
